# ── Turso (SQLite cloud) ─────────────────────────────────────────────────────
# 1. Create a free account at https://app.turso.tech
# 2. Create a database — copy the libsql URL shown on the database overview page
# 3. Go to the database → Tokens tab → Create token, then copy it

TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ── Push schema to Turso ──────────────────────────────────────────────────────
# Run once after setting the vars above to create all tables in Turso:
#   pnpm db:push
#
# Note: pnpm db:push uses "from empty" diffing. If tables already exist,
# write incremental SQL manually and run it in the Turso web shell (app.turso.tech).

# ── Seed the database (optional) ─────────────────────────────────────────────
#   pnpm db:seed

# ── Deploy to Vercel ──────────────────────────────────────────────────────────
# Add TURSO_DATABASE_URL and TURSO_AUTH_TOKEN as environment variables in your
# Vercel project settings: Settings → Environment Variables
